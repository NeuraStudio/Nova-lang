module NovaGame {
@Native("nova_game_vec3_dot") function vec3_dot(x1: Float, y1: Float, z1: Float, x2: Float, y2: Float, z2: Float) {}
@Native("nova_game_vec3_distance") function vec3_distance(x1: Float, y1: Float, z1: Float, x2: Float, y2: Float, z2: Float) {}
@Native("nova_game_ecs_create_entity") function create_entity() {}
@Native("nova_game_ecs_add_transform") function add_transform(entityId: Int, x: Float, y: Float, z: Float) {}
@Native("nova_game_gl_clear") function gl_clear(r: Float, g: Float, b: Float, a: Float) {}
}

function main() {
Nova.show("--- NOVA GAME ENGINE (ECS & 3D MATH) TEST ---")
dist = NovaGame.vec3_distance(0.0, 0.0, 0.0, 3.0, 4.0, 0.0)
Nova.show("Distance (0,0,0) to (3,4,0):")
Nova.show(dist)
player_id = NovaGame.create_entity()
Nova.show("Spawned Player Entity ID:")
Nova.show(player_id)
NovaGame.add_transform(player_id, 100.0, 50.0, 0.0)
Nova.show("Added Transform Component to Player (100, 50, 0)")
Nova.show("Game Engine API Execution Complete.")
}
