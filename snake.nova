score = 150
snake_x = 10
snake_y = 10
Nova.bg.colour("black")
Nova.clear()
Nova.text.colour("green")
print("====================================")
print("=          NOVA SNAKE 3D           =")
print("====================================")
print("Score: ", score)
print("Controls: W, A, S, D")
